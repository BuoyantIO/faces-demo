# goreleaser-style faces-admin image: copies the prebuilt binary plus the
# admin SPA assets. alpine (not scratch) because the admin can call HTTPS
# endpoints (e.g. emojivoto) and needs CA certificates.
FROM alpine:3.19 AS final
ARG WORKLOAD

RUN apk add --no-cache ca-certificates

# This is associated with the faces-demo repo.
LABEL org.opencontainers.image.source=https://github.com/BuoyantIO/faces-demo

# Copy the compiled binary from the builder stage into the final image
COPY --chmod=0755 ${WORKLOAD} /workload

# Also copy the admin SPA to be served.
COPY assets/html/admin /app/data
ENV DATA_PATH=/app/data

EXPOSE 8888

# Set the entrypoint to the compiled binary
ENTRYPOINT ["/workload"]
