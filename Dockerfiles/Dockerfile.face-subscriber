FROM golang:1.24-alpine AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build \
    -ldflags="-s -w" \
    -o /bin/face-subscriber \
    ./cmd/generic/face-subscriber

FROM alpine:3.19
RUN apk add --no-cache ca-certificates
COPY --from=builder /bin/face-subscriber /bin/face-subscriber
EXPOSE 8000
ENTRYPOINT ["/bin/face-subscriber"]
