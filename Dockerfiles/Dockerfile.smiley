FROM golang:1.24-alpine AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build \
    -ldflags="-s -w" \
    -o /bin/smiley \
    ./cmd/generic/smiley

FROM alpine:3.19
RUN apk add --no-cache ca-certificates
COPY --from=builder /bin/smiley /bin/smiley
EXPOSE 8000
ENTRYPOINT ["/bin/smiley"]
