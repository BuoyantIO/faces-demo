FROM golang:1.24-alpine AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build \
    -ldflags="-s -w" \
    -o /bin/color \
    ./cmd/generic/color

FROM alpine:3.19
RUN apk add --no-cache ca-certificates
COPY --from=builder /bin/color /bin/color
EXPOSE 8000
ENTRYPOINT ["/bin/color"]
