@dataclass
class FetchResult:
    status: object
    text: str
    color: str
    border_color: str = DEFAULT_GREY
    ok: bool = False
    any_timeouts: bool = False
    errors: str = ""
    update_text: bool = True
    update_color: bool = True
    pod: str = ""
    http_status: object = 0
    latency_ms: int = 0


@dataclass
class CellState:
    row: int
    col: int
    kind: str
    text: str = ""
    color: str = DEFAULT_GREY
    border_color: str = DEFAULT_GREY
    count: int = 0
    last_status: object = 0
    last_updated: float = 0.0
    pending: Optional[concurrent.futures.Future] = None
    next_due: float = 0.0
    latency_ms: int = 0
    errors: str = ""


@dataclass
class PodState:
    name: str
    text: str = ""
    color: str = DEFAULT_GREY
    border_color: str = DEFAULT_GREY
    count: int = 0
    last_status: object = 0
    last_updated: float = 0.0


@dataclass
class AppState:
    active: bool = True
